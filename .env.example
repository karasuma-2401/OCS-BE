ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Neon PostgreSQL connection string; keep sslmode=require from the Neon dashboard.
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Database=YOUR_DATABASE;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

Redis__ConnectionString=redis:6379
Jwt__Issuer=ocs-api
Jwt__Audience=ocs-clients
Jwt__Key=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
Cors__AllowedOrigins__2=http://localhost:8081

# Cloudflare R2 S3 API credentials. Scope the token to the OCS bucket.
R2__ServiceUrl=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2__AccessKeyId=YOUR_R2_ACCESS_KEY_ID
R2__SecretAccessKey=YOUR_R2_SECRET_ACCESS_KEY
R2__BucketName=ocs
R2__PublicBaseUrl=
