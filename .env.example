ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Neon PostgreSQL connection string; keep sslmode=require from the Neon dashboard.
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Database=YOUR_DATABASE;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

Redis__ConnectionString=
Jwt__Issuer=ocs-api
Jwt__Audience=ocs-clients
Jwt__Key=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
Cors__AllowedOrigins__2=http://localhost:8081

# Gmail SMTP for Auth OTP. Use a dedicated sender and inject the real App Password through an ignored
# local secret file or environment variable. Never fill a real password into this committed example.
Email__Provider=GmailSmtp
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Security=StartTls
Email__Username=YOUR_OCS_GMAIL_ADDRESS
Email__AppPassword=
Email__FromAddress=YOUR_OCS_GMAIL_ADDRESS
Email__FromName=OCS

# Cloudflare R2 S3 API credentials. Scope the token to the OCS bucket.
R2__ServiceUrl=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2__AccessKeyId=YOUR_R2_ACCESS_KEY_ID
R2__SecretAccessKey=YOUR_R2_SECRET_ACCESS_KEY
R2__BucketName=ocs
R2__PublicBaseUrl=

# VietQR Payment Adapter configuration for Web POS
VietQr__Provider=VietQrQuickLink
VietQr__BankCode=MB
VietQr__AccountNumber=0900000001
VietQr__AccountHolderName=CUA HANG KY GUI OCS
VietQr__Template=compact2
VietQr__ExpiryMinutes=10
VietQr__ReferencePrefix=OCS
VietQr__QuickLinkBaseUrl=https://img.vietqr.io/image
VietQr__WebhookSecret=
VietQr__EnableWebhookSimulation=true

# Optional Ngrok Webhook Tunnel for local development
NGROK_AUTHTOKEN=
NGROK_DOMAIN=unorderable-eventful-lovetta.ngrok-free.dev
